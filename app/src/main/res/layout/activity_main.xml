<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <Button
        android:id="@+id/startBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Screen Capture"/>

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="16dp"
        android:scaleType="fitCenter"
        android:contentDescription="Screen capture preview" />

    <TextView
        android:id="@+id/notificationTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Latest notification will be shown here" />

    <Button
        android:id="@+id/btnStartStream"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Stream"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btnStopStream"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop Stream"
        android:layout_marginTop="8dp" />




</LinearLayout>
